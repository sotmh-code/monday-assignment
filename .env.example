# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Process environment variables take precedence over values in .env.

# --- AI model provider (required for live runs) ---
CRESTVIEW_LLM_PROVIDER=anthropic
CRESTVIEW_LLM_API_KEY=put_your_key_here
CRESTVIEW_LLM_MODEL=claude-sonnet-5-5
# low | medium | high  (thinking depth / cost)
CRESTVIEW_LLM_EFFORT=medium
CRESTVIEW_LLM_TIMEOUT_SECONDS=120
# SDK-level retries for 408/409/429/5xx/connection errors (exponential backoff + jitter)
CRESTVIEW_LLM_MAX_RETRIES=3
# Parallel applications in flight (keep modest to respect rate limits)
CRESTVIEW_MAX_CONCURRENCY=3

# --- Optional monday.com integration (sandbox / trial account only) ---
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
MONDAY_API_VERSION=2026-10
